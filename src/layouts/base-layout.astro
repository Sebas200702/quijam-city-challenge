---
import AgentDock from "../components/agent-dock/agent-dock";
import type { ScreenRole } from "../lib/assistant/screen-context-types";
import "../styles/global.css";
// Shapes and motion shared by every screen (classes `l-*`).
import "../styles/landing.css";

interface Props {
	title: string;
	/** Key of the title in the i18n dictionaries (e.g. "agenda.pageTitle"), to translate it. */
	titleKey?: string;
	/** Default theme before the saved choice (applied by the inline script) loads. */
	theme?: "light" | "dark";
	/**
	 * False for pages still written only in Spanish: `<html lang>` then stays "es"
	 * whatever language the visitor chose (WCAG 3.1.1). Translated parts inside
	 * set their own `lang`.
	 */
	translated?: boolean;
	/**
	 * The Quillart AI dock for this surface (audit v2, U03), or false for pages
	 * that are the conversation themselves (/inicio) or are not app screens.
	 */
	dock?: ScreenRole | false;
	/** Full-screen pages (the map) make room for the dock themselves. */
	dockOverlay?: boolean;
}

const {
	title,
	titleKey,
	theme = "light",
	translated = true,
	dock = "visitor",
	dockOverlay = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme={theme} data-lang-fixed={translated ? undefined : ""}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png?v=2" />
		<link rel="shortcut icon" href="/favicon.ico?v=2" />
		{/* Installable app (#47): manifest for Android, touch icon and title for iOS. */}
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="theme-color" content="#007A33" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="QUILLART" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
		/>
		<title data-i18n={titleKey}>{title}</title>
		<script is:inline>
			// Light is the default theme; apply a saved choice before the first paint.
			try {
				const theme = localStorage.getItem("quillart-theme");
				if (theme === "light" || theme === "dark") {
					document.documentElement.dataset.theme = theme;
				}
			} catch {}
			// Same for the interface language (the page itself is served in Spanish),
			// unless the page is only in Spanish.
			try {
				const lang = localStorage.getItem("quillart-lang");
				const fixed = document.documentElement.hasAttribute("data-lang-fixed");
				if (!fixed && ["es", "en", "pt", "fr"].includes(lang)) {
					document.documentElement.lang = lang;
				}
			} catch {}
			// Motion is opt-in (see landing.css). If the motion script never arrives,
			// the class comes off again so nothing stays hidden.
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
				const root = document.documentElement;
				root.classList.add("l-motion");
				setTimeout(() => {
					if (!root.dataset.landingMotion) root.classList.remove("l-motion");
				}, 3000);
			}
		</script>
	</head>
	<body
		class="q-root l-page min-h-dvh bg-bg text-ink antialiased"
		data-dock={dockOverlay ? "overlay" : undefined}
	>
		<div class="q-flag q-flag--thin" aria-hidden="true">
			<i></i><i></i><i></i>
		</div>
		<slot />
		{dock && <AgentDock client:only="react" role={dock} />}
		<script>
			import { initLandingMotion } from "../components/landing/landing-motion";
			import { initStaticText } from "../lib/i18n/apply-static";
			import { registerServiceWorker } from "../lib/offline/register-service-worker";
			initStaticText();
			registerServiceWorker();
			initLandingMotion();
		</script>
	</body>
</html>
