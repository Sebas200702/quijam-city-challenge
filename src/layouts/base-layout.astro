---
import AgentDock from "../components/agent-dock/agent-dock";
import type { ScreenRole } from "../lib/assistant/screen-context-types";
import "../styles/global.css";

interface Props {
	title: string;
	/** Key of the title in the i18n dictionaries (e.g. "agenda.pageTitle"), to translate it. */
	titleKey?: string;
	/** Default theme before the saved choice (applied by the inline script) loads. */
	theme?: "light" | "dark";
	/**
	 * The Quillart AI dock for this surface (audit v2, U03), or false for pages
	 * that are the conversation themselves (/inicio) or are not app screens.
	 */
	dock?: ScreenRole | false;
	/** Full-screen pages (the map) make room for the dock themselves. */
	dockOverlay?: boolean;
}

const {
	title,
	titleKey,
	theme = "light",
	dock = "visitor",
	dockOverlay = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme={theme}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{/* Installable app (#47): manifest for Android, touch icon and title for iOS. */}
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="theme-color" content="#007A33" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="QUILLART" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
		/>
		<title data-i18n={titleKey}>{title}</title>
		<script is:inline>
			// Light is the default theme; apply a saved choice before the first paint.
			try {
				const theme = localStorage.getItem("quillart-theme");
				if (theme === "light" || theme === "dark") {
					document.documentElement.dataset.theme = theme;
				}
			} catch {}
			// Same for the interface language (the page itself is served in Spanish).
			try {
				const lang = localStorage.getItem("quillart-lang");
				if (["es", "en", "pt", "fr"].includes(lang)) {
					document.documentElement.lang = lang;
				}
			} catch {}
		</script>
	</head>
	<body
		class="q-root min-h-dvh bg-bg text-ink antialiased"
		data-dock={dockOverlay ? "overlay" : undefined}
	>
		<div class="q-flag q-flag--thin" aria-hidden="true">
			<i></i><i></i><i></i>
		</div>
		<slot />
		{dock && <AgentDock client:only="react" role={dock} />}
		<script>
			import { initStaticText } from "../lib/i18n/apply-static";
			import { registerServiceWorker } from "../lib/offline/register-service-worker";
			initStaticText();
			registerServiceWorker();
		</script>
	</body>
</html>
