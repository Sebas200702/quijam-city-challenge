---
import "../styles/global.css";

interface Props {
	title: string;
	/** Key of the title in the i18n dictionaries (e.g. "agenda.pageTitle"), to translate it. */
	titleKey?: string;
	/** Default theme before the saved choice (applied by the inline script) loads. */
	theme?: "light" | "dark";
}

const { title, titleKey, theme = "light" } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme={theme}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
		/>
		<title data-i18n={titleKey}>{title}</title>
		<script is:inline>
			// Light is the default theme; apply a saved choice before the first paint.
			try {
				const theme = localStorage.getItem("quillart-theme");
				if (theme === "light" || theme === "dark") {
					document.documentElement.dataset.theme = theme;
				}
			} catch {}
			// Same for the interface language (the page itself is served in Spanish).
			try {
				const lang = localStorage.getItem("quillart-lang");
				if (["es", "en", "pt", "fr"].includes(lang)) {
					document.documentElement.lang = lang;
				}
			} catch {}
		</script>
	</head>
	<body class="q-root min-h-dvh bg-bg text-ink antialiased">
		<div class="q-flag q-flag--thin" aria-hidden="true">
			<i></i><i></i><i></i>
		</div>
		<slot />
		<script>
			import { initStaticText } from "../lib/i18n/apply-static";
			initStaticText();
		</script>
	</body>
</html>
