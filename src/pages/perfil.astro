---
import { ProfilePage } from "../components/community/profile-page";
import SiteFooter from "../components/site/site-footer.astro";
import SiteHeader from "../components/site/site-header.astro";
import BaseLayout from "../layouts/base-layout.astro";
import { homeContent } from "../lib/home-content";

const { aiHref } = homeContent;
---

<BaseLayout title="Mi perfil · QUILLART" titleKey="profile.pageTitle">
	<SiteHeader current="profile" homeHref="/inicio" title="Perfil" titleKey="nav.profile">
		<a slot="actions" href="/perfil" class="q-btn q-btn--ghost q-btn--sm min-h-11 max-lg:hidden!" aria-current="page"><span data-i18n="nav.profile">Perfil</span></a>
	</SiteHeader>
	<ProfilePage client:only="react" aiHref={aiHref} />
	<SiteFooter variant="slim" />
</BaseLayout>
