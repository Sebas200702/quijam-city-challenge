	sections: [
		{
			id: "responsable",
			title: "1. Responsable del tratamiento",
			blocks: [
				{
					p: "QUILLART, proyecto del Quijam City Challenge en Barranquilla, Colombia, es el responsable del tratamiento de los datos descritos en esta política.",
				},
				{
					p: `Contacto para temas de datos personales: ${CONTACT_PLACEHOLDER}.`,
