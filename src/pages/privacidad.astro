// Privacy policy (Ley 1581 de 2012, habeas data; minimum content of Decreto 1377
// de 2013, art. 13) and the public URL the Google OAuth consent screen asks for.
// Every practice below comes from the repository (docs 22, 27, 28, 29, 11, 02;
// supabase/migrations; src/pages/api). Spanish is the source text; the English
// version follows it section by section. pt and fr are not translated yet.
// Static page: no islands and no inline scripts of its own (CSP).
import BaseLayout from "../layouts/base-layout.astro";

type Block =
	| { p: string }
	| { ul: string[] }
	| { p: string; link: { href: string; label: string } };

interface Section {
	id: string;
	title: string;
	blocks: Block[];
}

interface Policy {
	lang: "es" | "en";
	eyebrow: string;
	title: string;
	lead: string;
	effective: string;
	sections: Section[];
}

