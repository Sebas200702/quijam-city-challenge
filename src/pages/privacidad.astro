const policies = [es, en];
---

<BaseLayout title="Política de privacidad · QUILLART" theme="light">
	<main class="mx-auto w-full max-w-2xl px-4 pt-6 pb-16 lg:py-10">
		<nav class="mb-8 flex flex-wrap items-center justify-between gap-3" aria-label="Privacidad">
			<a href="/" class="q-btn q-btn--ghost q-btn--sm">← QUILLART</a>
			<a href="#en" class="q-sm underline" hreflang="en" lang="en">Read in English</a>
		</nav>
		{
			policies.map((policy) => (
				<article
					lang={policy.lang}
					id={policy.lang}
					aria-labelledby={`${policy.lang}-title`}
					class="q-stack mb-16 border-line border-b pb-16 last:mb-0 last:border-b-0 last:pb-0"
				>
					<header class="q-stack mb-4">
						<p class="q-eyebrow">{policy.eyebrow}</p>
						<h1 id={`${policy.lang}-title`} class="q-h1">
							{policy.title}
						</h1>
						<p class="q-lead">{policy.lead}</p>
						<p class="q-sm q-muted">
							<strong>{policy.effective}</strong>
						</p>
					</header>
					{policy.sections.map((section) => (
						<section
							id={section.id}
							aria-labelledby={`${section.id}-h`}
							class="q-stack mt-6"
						>
							<h2 id={`${section.id}-h`} class="q-h3">
								{section.title}
							</h2>
							{section.blocks.map((block) =>
								"ul" in block ? (
									<ul class="q-p list-disc space-y-2 pl-5 leading-relaxed">
										{block.ul.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								) : "link" in block ? (
									<p class="q-p leading-relaxed">
										{block.p}{" "}
										<a href={block.link.href} class="font-semibold underline">
											{block.link.label}
										</a>
									</p>
								) : (
									<p class="q-p leading-relaxed">{block.p}</p>
								),
							)}
						</section>
					))}
				</article>
			))
		}
	</main>
</BaseLayout>
