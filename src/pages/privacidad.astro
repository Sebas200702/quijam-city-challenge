---
// Privacy policy (Ley 1581 de 2012, habeas data) and the public URL the Google
// OAuth consent screen asks for. Every practice below comes from the repository
// docs (22-seguridad-y-confianza, 27-comunidad-y-moderacion, 28-quillart-ai,
// 11-modelo-datos, 02-decisiones). Spanish is the source text; the English
// version follows it section by section. pt and fr are not translated yet.
// Static page: no islands and no inline scripts of its own (CSP).
import BaseLayout from "../layouts/base-layout.astro";

type Block =
	| { p: string }
	| { ul: string[] }
	| { p: string; link: { href: string; label: string } };

interface Section {
	id: string;
	title: string;
	blocks: Block[];
}

interface Policy {
	lang: "es" | "en";
	eyebrow: string;
	title: string;
	lead: string;
	effective: string;
	sections: Section[];
}

// TODO(legal): replace with the official contact channel of the data controller.
const CONTACT_PLACEHOLDER = "[PENDIENTE: correo de contacto del responsable]";

const es: Policy = {
	lang: "es",
