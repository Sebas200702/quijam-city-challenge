			.phone .q-msg__col { max-width: 88%; }
			.phone .q-bubble { font-size: 15px; }
			.confirm { box-shadow: var(--shadow-card), inset 0 0 0 1px var(--line); }
			.confirm .q-card__body { padding: 16px; gap: 8px; }
			.confirm__btns { display: flex; gap: 8px; margin-top: 4px; }
			.on .press { animation: press .6s 1.2s ease both; }
			@keyframes press { 40% { transform: scale(.92); box-shadow: var(--glow-gold); } }
			.evt { flex-direction: row; align-items: center; gap: 12px; padding: 10px; }
			.evt__illus { width: 84px; height: 84px; padding: 8px; flex: none; border-radius: 14px; }
			.evt__body { display: flex; flex-direction: column; gap: 6px; }
			.evt__body .q-badge { align-self: flex-start; }
			.demo__pair { display: flex; gap: 28px; align-items: center; }
			.queue { width: 440px; border-radius: var(--radius-lg); background: var(--surface); color: var(--ink); padding: 20px; display: flex; flex-direction: column; gap: 12px; box-shadow: var(--shadow-modal); }
			.queue__head { display: flex; justify-content: space-between; align-items: baseline; font-family: var(--font-display); }
			.queue__row { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: var(--radius-md); background: var(--bg); position: relative; }
			.queue__ic { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--red); color: var(--on-red); flex: none; font-weight: 700; }
			.queue__ic--ok { background: var(--green); color: var(--on-green); }
			.queue__txt { flex: 1; display: flex; flex-direction: column; font-size: 15px; }
			.st { position: absolute; right: 12px; transition: opacity .4s, transform .5s cubic-bezier(.2,.8,.2,1.3); }
			.st--ok { opacity: 0; transform: scale(.6); }
			.queue.confirmed .st--wait { opacity: 0; transform: scale(.6); }
			.queue.confirmed .st--ok { opacity: 1; transform: none; }
			.queue.confirmed .queue__row:first-of-type { box-shadow: var(--glow-red); }
			.queue__btn { align-self: flex-end; }

			/* ── 12 · Works today ── */
			.checks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 32px 48px; margin-top: 24px; }
			.checks li { display: flex; align-items: center; gap: 18px; font-size: 28px; font-weight: 500; opacity: 0; transform: translateX(-20px); transition: opacity .5s, transform .6s cubic-bezier(.2,.8,.2,1); }
			.checks li::before { content: '✓'; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; flex: none; background: var(--green); color: var(--on-green); font-weight: 700; font-size: 18px; }
			.is-active .checks li { opacity: 1; transform: none; transition-delay: calc(.5s + var(--i) * .11s); }
			.stack { margin: 18px 0 0; color: var(--ink-subtle); font-size: 17px; }

			/* Prototype level, on the scale the organizer defined (conceptual → validado). */
			.level { margin-top: auto; display: flex; align-items: center; gap: 24px; }
			.level__label { font-family: var(--font-display); font-weight: 700; font-size: 15px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-subtle); }
			.level__steps { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; }
			.level__steps li { height: 40px; padding: 0 18px; display: grid; place-items: center; border-radius: 999px; font-size: 16px; font-weight: 600; background: var(--surface); color: var(--ink-subtle); box-shadow: var(--shadow-card); }
			.level__steps .is-done { color: var(--green-text); background: var(--green-soft); box-shadow: none; }
			.level__steps .is-now { color: var(--on-green); background: var(--green); box-shadow: var(--glow-green, none); }
			.level__steps .is-next { border: 2px dashed var(--line); background: transparent; box-shadow: none; }

			/* ── Evolution across sprints ── */
			.sprints { display: flex; align-items: stretch; gap: 20px; margin-top: 28px; }
			.sprint { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 26px 28px; border-radius: var(--radius-xl); background: var(--surface); box-shadow: var(--shadow-card); }
			.sprint__n { font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-subtle); }
			.sprint b { font-family: var(--font-display); font-size: 30px; line-height: 1.1; }
			.sprint p { margin: 0; font-size: 19px; line-height: 1.4; color: var(--ink-muted); }
			.sprint--red { box-shadow: var(--shadow-card), inset 0 4px 0 var(--red); }
			.sprint--green { box-shadow: var(--shadow-card), inset 0 4px 0 var(--green); }
			.sprint__quote { font-family: var(--font-display); font-size: 26px !important; color: var(--red-text) !important; }
			.sprint__list { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 17px; }
			.sprint__list--old li { color: var(--ink-subtle); text-decoration: line-through; text-decoration-color: var(--red); text-decoration-thickness: 2px; }
			.sprint__list--new li { color: var(--green-text); font-weight: 600; }
			.sprint__list--new li::before { content: '✓ '; }
			.sprint__arrow { align-self: center; font-size: 32px; color: var(--ink-subtle); }

			/* ── 13 · Lessons ── */
			.lessons { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
			.lessons li { display: flex; align-items: center; gap: 22px; padding: 14px 22px; border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-card); }
			.lessons__n { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--surface-raised); font-size: 22px; font-weight: 700; flex: none; }
			.lessons li div { flex: 1; display: flex; flex-direction: column; gap: 2px; }
			.lessons b { font-family: var(--font-display); font-size: 22px; text-transform: uppercase; letter-spacing: .03em; }
			.lessons span { font-size: 18px; color: var(--ink-muted); }
			.tick { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-weight: 700; font-size: 20px; background: var(--green); color: var(--on-green); transform: scale(0); transition: transform .5s .35s cubic-bezier(.2,.9,.2,1.5); }
			.lessons li.on .tick { transform: scale(1); }
			.lessons li.on { box-shadow: var(--shadow-card), inset 4px 0 0 var(--green); }

			/* ── 14 · Viability ── */
			.road { position: relative; height: 110px; margin-top: 8px; }
			.road__line { position: absolute; left: 0; right: 0; top: 18px; height: 4px; background: var(--line); border-radius: 4px; overflow: hidden; }
			.road__line i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--gold), var(--green)); transition: width 2s .6s cubic-bezier(.4,0,.2,1); }
			.is-active .road__line i { width: 100%; }
			.road__pt { position: absolute; top: 0; left: calc(var(--p) * 24.5%); display: flex; flex-direction: column; gap: 6px; padding-top: 0; }
			.road__pt::before { content: ''; width: 40px; height: 40px; border-radius: 50%; background: var(--surface-raised); box-shadow: inset 0 0 0 3px var(--line-control); }
			.road__pt--gold::before { background: var(--gold); box-shadow: var(--glow-gold); }
			.road__pt--green::before { background: var(--green); box-shadow: var(--glow-green); }
			.road__pt b { font-size: 26px; }
			.road__pt span { color: var(--ink-muted); font-size: 16px; }
			.road__pt:last-child { left: auto; right: 0; align-items: flex-end; }
			.road__pt:last-child::before { align-self: flex-end; }
			.viable { display: grid; grid-template-columns: 1.3fr .8fr 1.2fr; gap: 20px; margin-top: 12px; }
			.viable .q-kpi { padding: 24px; gap: 10px; }
			.allies { font-size: 20px; line-height: 30px; font-weight: 600; }

			/* ── 15 · Close ── */
			.s-close { align-items: center; justify-content: center; text-align: center; gap: 36px; }
			.close__q { margin: 0; font-family: var(--font-display); font-size: 34px; color: var(--ink-muted); font-style: italic; }
			.close__a { margin: 0; font-family: var(--font-display); font-size: 150px; line-height: 1; font-weight: 700; letter-spacing: -0.04em; }
			.close__line { margin: 0; font-size: 32px; color: var(--ink-muted); }
			.close__line strong { color: var(--ink); }
			.close__foot { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-top: 20px; }
			.team { margin: 0; color: var(--ink-subtle); font-size: 16px; }

			/* ── Connection graph ── */
			.graph { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: .3; transition: opacity 1.2s ease; }
			body.strong .graph { opacity: .7; }
			.graph .n { transition: opacity 1s, r .8s; opacity: .7; }
			.graph .n--p { fill: var(--ink-muted); }
			.graph .n--e { fill: var(--green); }
			.graph .n--c { fill: var(--red); }
			.graph .e { fill: none; stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1), opacity 1s; opacity: 0; }
			.graph .e--p2p { stroke: var(--gold); }
			.graph .e--p2e { stroke: var(--green); }
			.graph .e--p2c { stroke: var(--red); stroke-width: 1.5; }
			body.g-p2p .graph .e--p2p, body.g-p2e .graph .e--p2e, body.g-p2c .graph .e--p2c { stroke-dashoffset: 0; opacity: .85; }
			body.g-p2p .graph .n--p { fill: var(--gold); opacity: 1; }
			body.g-scatter .graph .n--p { animation: float 6s ease-in-out infinite alternate; }
			body.lit .graph .n { filter: drop-shadow(0 0 6px currentColor); }
			body.lit .graph .n--p { color: var(--gold); }
			@keyframes float { to { transform: translate(var(--dx), var(--dy)); } }

			/* ── Act transition ── */
			.actfx { position: fixed; inset: 0; display: grid; place-items: center; pointer-events: none; opacity: 0; z-index: 20; }
			.actfx.go { animation: fxfade 1.3s ease both; }
			.actfx__rings { position: absolute; width: 360px; aspect-ratio: 3/2; display: grid; place-items: center; }
			.actfx__rings i { position: absolute; inset: 0; border-radius: 40px; border: 3px solid var(--red); }
			.actfx__rings i:nth-child(2) { inset: 14%; border-color: var(--gold); }
			.actfx__rings i:nth-child(3) { inset: 28%; border-color: var(--green); }
			.actfx.go .actfx__rings i { animation: ring 1.3s cubic-bezier(.2,.7,.2,1) both; }
			.actfx.go .actfx__rings i:nth-child(2) { animation-delay: .08s; }
			.actfx.go .actfx__rings i:nth-child(3) { animation-delay: .16s; }
			.actfx__star { width: 72px; height: 72px; color: var(--act); }
			.actfx.go .actfx__star { animation: q-spin 1.1s cubic-bezier(.65,0,.35,1) both; }
			.actfx__label { position: absolute; top: calc(50% + 70px); margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: .12em; text-transform: uppercase; color: var(--act-text); }
			@keyframes fxfade { 0% { opacity: 0; } 15% { opacity: 1; } 70% { opacity: 1; } 100% { opacity: 0; } }
			@keyframes ring { from { transform: scale(.2); opacity: 1; } to { transform: scale(3.2); opacity: 0; } }

			/* ── HUD and notes ── */
			.hud { position: fixed; left: 0; right: 0; bottom: 0; height: 4px; z-index: 10; }
			.hud__bar { height: 100%; width: 0; background: linear-gradient(90deg, var(--red), var(--gold) 50%, var(--green)); transition: width .8s cubic-bezier(.2,.7,.2,1); }
			.hud__count { position: fixed; right: 20px; bottom: 14px; font-size: 13px; color: var(--ink-subtle); }
			.notes { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 30; max-width: 900px; margin: 0 auto; padding: 18px 22px; border-radius: var(--radius-lg); background: color-mix(in srgb, var(--surface-raised) 96%, transparent); box-shadow: var(--shadow-modal); display: flex; flex-direction: column; gap: 10px; user-select: text; }
			.notes[hidden] { display: none; }
			.notes__head { display: flex; gap: 16px; align-items: baseline; font-weight: 600; }
			.notes__clock { color: var(--gold-text); font-size: 20px; }
			.notes p { margin: 0; font-size: 17px; line-height: 26px; }
			.note { display: none; }

			@media (prefers-reduced-motion: reduce) {
				.deck *, .deck *::before, .deck *::after { animation: none !important; transition-duration: .01s !important; transition-delay: 0s !important; }
				.actfx { display: none; }
			}
		</style>

		<script is:inline>
			(() => {
				const stage = document.getElementById("stage");
				const slides = Array.from(stage.querySelectorAll(".slide"));
				const body = document.body;
				const graph = document.getElementById("graph");
				const ACT_LABEL = { problema: "01 · El problema", propuesta: "02 · La propuesta", programa: "03 · El programa", prototipo: "04 · El prototipo", legado: "05 · Impacto y legado", cierre: "" };
				const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

				// Fit the 1600×900 stage to any screen.
				const fit = () => {
					const s = Math.min(window.innerWidth / 1600, window.innerHeight / 900);
					stage.style.transform = `translate(-50%, -50%) scale(${s})`;
				};
				window.addEventListener("resize", fit);
				fit();

				// ── Connection graph (seeded, so it looks the same every time) ──
				let seed = 7;
				const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
				const NS = "http://www.w3.org/2000/svg";
				const people = [];
				for (let i = 0; i < 26; i++) {
					const x = 60 + rnd() * 1480;
					const y = 50 + rnd() * 800;
					people.push({ x, y });
				}
				const places = [[260, 640], [720, 160], [1180, 700], [1420, 260], [480, 300]].map(([x, y]) => ({ x, y }));
				const city = { x: 1260, y: 470 };
				const edges = [];
				const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
				people.forEach((p, i) => {
					const near = people
						.map((q, j) => ({ j, d: dist(p, q) }))
						.filter((o) => o.j > i)
						.sort((a, b) => a.d - b.d)
						.slice(0, 2);
					near.forEach((o) => { if (o.d < 420) edges.push(["p2p", p, people[o.j]]); });
					const pl = places.slice().sort((a, b) => dist(p, a) - dist(p, b))[0];
					if (i % 2 === 0) edges.push(["p2e", p, pl]);
					if (i % 3 === 0) edges.push(["p2c", p, city]);
				});
				places.forEach((pl) => edges.push(["p2c", pl, city]));
				edges.forEach(([kind, a, b], k) => {
					const path = document.createElementNS(NS, "path");
					const mx = (a.x + b.x) / 2 + (rnd() - 0.5) * 80;
					const my = (a.y + b.y) / 2 + (rnd() - 0.5) * 80;
					path.setAttribute("d", `M${a.x},${a.y} Q${mx},${my} ${b.x},${b.y}`);
					path.setAttribute("pathLength", "1");
					path.setAttribute("class", `e e--${kind}`);
					path.style.transitionDelay = `${(k % 12) * 0.07}s`;
					graph.appendChild(path);
				});
				const dot = (p, cls, r) => {
					const c = document.createElementNS(NS, "circle");
					c.setAttribute("cx", p.x);
					c.setAttribute("cy", p.y);
					c.setAttribute("r", r);
					c.setAttribute("class", `n ${cls}`);
					c.style.setProperty("--dx", `${(rnd() - 0.5) * 30}px`);
					c.style.setProperty("--dy", `${(rnd() - 0.5) * 30}px`);
					c.style.animationDelay = `${-rnd() * 6}s`;
					graph.appendChild(c);
				};
				people.forEach((p) => dot(p, "n--p", 6));
				places.forEach((p) => dot(p, "n--e", 9));
				const star = document.createElementNS(NS, "polygon");
				const pts = [];
				for (let i = 0; i < 16; i++) {
					const r = i % 2 === 0 ? 26 : 11;
					const a = (Math.PI / 8) * i - Math.PI / 2;
					pts.push(`${city.x + r * Math.cos(a)},${city.y + r * Math.sin(a)}`);
				}
				star.setAttribute("points", pts.join(" "));
				star.setAttribute("class", "n n--c");
				graph.appendChild(star);

				// ── Navigation state ──
				let idx = 0;
				let step = 0;
				let act = null;
				const stepsOf = (s) => Array.from(s.querySelectorAll("[data-step]"));
				const maxStep = (s) => stepsOf(s).reduce((m, e) => Math.max(m, Number(e.dataset.step)), 0);

				const countUp = (el) => {
					if (el.dataset.done) return;
					el.dataset.done = "1";
					const to = Number(el.dataset.count);
					const pre = el.dataset.prefix || "";
					const fmt = (n) => pre + Math.round(n).toLocaleString("es-CO");
					if (reduced) { el.textContent = fmt(to); return; }
					const t0 = performance.now();
					const dur = 1800;
					const tick = (t) => {
						const k = Math.min(1, (t - t0) / dur);
						el.textContent = fmt(to * (1 - Math.pow(1 - k, 4)));
						if (k < 1) requestAnimationFrame(tick);
					};
					requestAnimationFrame(tick);
				};

				const playAct = (name) => {
					if (reduced || !ACT_LABEL[name] && name !== "cierre") return;
					const fx = document.getElementById("actfx");
					document.getElementById("actfx-label").textContent = ACT_LABEL[name] || "";
					fx.classList.remove("go");
					void fx.offsetWidth;
					fx.classList.add("go");
				};

				const render = (fromNav) => {
					const s = slides[idx];
					slides.forEach((el, i) => {
						el.classList.toggle("is-active", i === idx);
						el.classList.toggle("is-past", i < idx);
						if (i !== idx) el.querySelectorAll("[data-count]").forEach((c) => { delete c.dataset.done; c.textContent = "0"; });
					});
					const graphOn = new Set((s.dataset.graph || "").split(" ").filter(Boolean));
					stepsOf(s).forEach((e) => {
						const on = Number(e.dataset.step) <= step;
						e.classList.toggle("on", on);
						if (on && e.dataset.graphOn) graphOn.add(e.dataset.graphOn);
					});
					// Demo 3: the city confirms the report on its step.
					s.querySelectorAll(".queue").forEach((q) => q.classList.toggle("confirmed", step >= 4));
					// Demo 2: one seat fewer once Lucas is registered.
					s.querySelectorAll(".cupos").forEach((c) => { c.textContent = step >= 6 ? "39" : "40"; });

					body.className = body.className.replace(/\bg-\S+/g, "").trim();
					graphOn.forEach((g) => body.classList.add(`g-${g}`));
					body.classList.toggle("strong", s.hasAttribute("data-strong"));
					body.classList.toggle("lit", s.hasAttribute("data-lit"));

					const newAct = s.dataset.act;
					if (newAct !== act) {
						if (act !== null && fromNav === "fwd") playAct(newAct);
						act = newAct;
						body.dataset.act = newAct;
					}
					s.querySelectorAll("[data-count]").forEach(countUp);

					document.getElementById("bar").style.width = `${((idx + 1) / slides.length) * 100}%`;
					document.getElementById("count").textContent = `${idx + 1} / ${slides.length}`;
					document.getElementById("notes-slide").textContent = `Diapositiva ${idx + 1} / ${slides.length}`;
					document.getElementById("notes-target").textContent = `objetivo ${s.dataset.time || ""}`;
					document.getElementById("notes-text").textContent = s.querySelector(".note")?.textContent.trim() || "";
					history.replaceState(null, "", `#${idx + 1}`);
				};

				let started = null;
				const next = () => {
					if (started === null) started = Date.now();
					if (step < maxStep(slides[idx])) { step++; render(); return; }
					if (idx < slides.length - 1) { idx++; step = 0; render("fwd"); }
				};
				const prev = () => {
					if (step > 0) { step--; render(); return; }
					if (idx > 0) { idx--; step = maxStep(slides[idx]); render("back"); }
				};
				const go = (i) => { idx = Math.max(0, Math.min(slides.length - 1, i)); step = 0; render("jump"); };

				window.addEventListener("keydown", (e) => {
					if (e.metaKey || e.ctrlKey || e.altKey) return;
					const k = e.key;
					if (["ArrowRight", "ArrowDown", "PageDown", " ", "Enter"].includes(k)) { e.preventDefault(); next(); }
					else if (["ArrowLeft", "ArrowUp", "PageUp", "Backspace"].includes(k)) { e.preventDefault(); prev(); }
					else if (k === "Home") go(0);
					else if (k === "End") go(slides.length - 1);
					else if (k === "n" || k === "N") { const n = document.getElementById("notes"); n.hidden = !n.hidden; }
					else if (k === "f" || k === "F") { if (document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen?.(); }
					else if (k === "r" || k === "R") started = Date.now();
				});
				window.addEventListener("click", (e) => {
					if (e.target.closest(".notes")) return;
					if (e.clientX < window.innerWidth / 3) prev(); else next();
				});

				// Speaker clock.
				setInterval(() => {
					if (started === null) return;
					const s = Math.floor((Date.now() - started) / 1000);
					const el = document.getElementById("clock");
					el.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
					el.style.color = s > 420 ? "var(--red-text)" : "";
				}, 500);

				const fromHash = Number(location.hash.slice(1));
				if (fromHash >= 1 && fromHash <= slides.length) idx = fromHash - 1;
				render();
			})();
		</script>
	</body>
</html>
