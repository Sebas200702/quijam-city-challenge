		<style is:global>
			/* ── Deck shell ── */
			html, body.deck { height: 100%; overflow: hidden; }
			body.deck { --act: var(--gold); --act-soft: var(--gold-soft); --act-text: var(--gold-text); background: var(--bg); cursor: default; user-select: none; }
			body.deck[data-act="intro"], body.deck[data-act="cierre"] { --act: var(--gold); --act-soft: var(--gold-soft); --act-text: var(--gold-text); }
			body.deck[data-act="problema"] { --act: var(--red); --act-soft: var(--red-soft); --act-text: var(--red-text); }
			body.deck[data-act="legado"] { --act: var(--green); --act-soft: var(--green-soft); --act-text: var(--green-text); }

			.ambient { position: fixed; inset: -20%; pointer-events: none; background:
				radial-gradient(40% 45% at 18% 20%, color-mix(in srgb, var(--act) 22%, transparent), transparent 70%),
				radial-gradient(35% 40% at 85% 85%, color-mix(in srgb, var(--act) 14%, transparent), transparent 70%);
				transition: background 1.2s ease; animation: drift 18s ease-in-out infinite alternate; }
			@keyframes drift { to { transform: translate(3%, -2%) scale(1.05); } }

			.viewport { position: fixed; inset: 0; overflow: hidden; }
			.stage { position: absolute; left: 50%; top: 50%; width: 1600px; height: 900px; transform-origin: center; }

			/* ── Slides and transitions ── */
			.slide { position: absolute; inset: 0; padding: 88px 112px 96px; display: flex; flex-direction: column; gap: 28px;
				opacity: 0; visibility: hidden; transform: translateX(80px) scale(.98);
				transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1), visibility 0s linear .8s; }
			.slide.is-past { transform: translateX(-80px) scale(.98); }
			.slide.is-active { opacity: 1; visibility: visible; transform: none; transition-delay: .12s, .12s, 0s; }

			.rise { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .8s cubic-bezier(.2,.7,.2,1); }
			.is-active .rise { opacity: 1; transform: none; transition-delay: calc(.3s + var(--i, 0) * .12s); }

			[data-step] { opacity: 0; transform: translateY(22px) scale(.98); transition: opacity .55s ease, transform .65s cubic-bezier(.2,.8,.2,1.2); }
			[data-step].on { opacity: 1; transform: none; }

			/* ── Type ── */
			.title { margin: 0; font-family: var(--font-display); font-size: 68px; line-height: 1.04; font-weight: 700; letter-spacing: -0.025em; color: var(--ink); }
			.title--xl { font-size: 92px; }
			.muted { color: var(--ink-muted); }
			.ink { color: var(--ink); }
			.hl-gold { color: var(--gold-text); }
			.hl-red { color: var(--red-text); }
			.hl-green { color: var(--green-text); }
			.deck .q-eyebrow { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--act-text); transition: color 1s; }
			.dot { width: 10px; height: 10px; border-radius: 50%; }
			.dot--red { background: var(--red); } .dot--gold { background: var(--gold); } .dot--green { background: var(--green); }
			.punch { margin: 0; font-family: var(--font-display); font-size: 36px; line-height: 1.2; color: var(--ink-muted); }
			.punch strong { color: var(--ink); }
			.punch--center { text-align: center; margin-top: auto; }
			.source { position: absolute; left: 112px; bottom: 44px; margin: 0; font-size: 13px; color: var(--ink-subtle); }
			.deck .q-sim-tag { display: inline-flex; align-items: center; height: 22px; padding: 0 10px; border-radius: var(--radius-pill); background: var(--line); color: var(--ink-muted); font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
			.tag-ill { margin-left: 8px; }
