			.cover__logo .q-logo__word { font-size: 28px; }
			.cover__logo .q-logo__sub { font-size: 15px; }
			.cover__mark { width: 520px; flex: none; }
			.q-flagmark.build, .q-flagmark.build > i, .q-flagmark.build > i > i { transform: scale(0); transition: transform 1s cubic-bezier(.2,.9,.2,1.15); }
			.is-active .q-flagmark.build { transform: none; transition-delay: .4s; }
			.is-active .q-flagmark.build > i { transform: none; transition-delay: .7s; }
			.is-active .q-flagmark.build > i > i { transform: none; transition-delay: 1s; }
			.q-flagmark.build .big-star { width: 96px; height: 96px; }

			/* ── 2 · Carnaval ── */
			.carnaval__kpi { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
			.kpi-giant { font-family: var(--font-display); font-size: 168px; line-height: 1; font-weight: 700; letter-spacing: -0.04em; color: var(--red-text); font-variant-numeric: tabular-nums; }
			.kpi-giant__label { font-size: 26px; color: var(--ink-muted); }
			.carnaval__row { display: flex; gap: 20px; }
			.carnaval__row .q-kpi { min-width: 340px; }

			/* ── 3 · Broken links ── */
			.broken { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
			.broken__card { overflow: visible; }
			.broken__illus { margin: 16px 24px 0; height: 170px; }
			.broken__illus img { max-height: 138px; width: auto; }
			.broken__card .q-card__body p { font-size: 17px; line-height: 25px; }
			.cut { position: absolute; right: -24px; top: 50%; width: 20px; height: 3px; background: repeating-linear-gradient(90deg, var(--red) 0 5px, transparent 5px 10px); opacity: .9; }
			.broken__card:last-child .cut { display: none; }
			.broken__card.on { animation: shake .5s .5s ease; }
			@keyframes shake { 30% { transform: translateX(-4px) rotate(-.4deg); } 60% { transform: translateX(4px) rotate(.4deg); } }

			/* ── 4 · Proposal ── */
			.links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 8px; }
			.link { background: color-mix(in srgb, var(--surface) 94%, transparent); border-radius: var(--radius-lg); padding: 24px; display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-card); }
			.link--gold { --c: var(--gold); } .link--green { --c: var(--green); } .link--red { --c: var(--red); }
			.link.on { box-shadow: var(--shadow-card), 0 0 0 1px color-mix(in srgb, var(--c) 50%, transparent); }
			.link__ends { display: flex; align-items: center; gap: 0; height: 28px; color: var(--c); }
			.link__ends i { width: 22px; height: 22px; border-radius: 50%; background: var(--c); flex: none; }
			.link__ends i.sq { border-radius: 6px; }
			.link__ends .q-star { width: 28px; height: 28px; }
			.link__ends b { height: 3px; flex: 0 0 0; background: var(--c); transition: flex-basis .8s .3s cubic-bezier(.2,.8,.2,1); }
			.link.on .link__ends b { flex-basis: 120px; }
			.quote { margin: auto 0 0; font-family: var(--font-display); font-size: 30px; line-height: 1.3; color: var(--ink-muted); max-width: 1200px; border-left: 0; }

			/* ── 5 · Orchestrator ── */
			.orch { display: grid; grid-template-columns: 430px 120px 180px 1fr; align-items: center; gap: 0; margin-top: 24px; }
			.orch__in { display: flex; flex-direction: column; gap: 12px; }
			.orch__prompt { padding: 16px 22px; font-size: 18px; color: var(--ink); gap: 14px; }
			.orch__star { color: var(--gold); }
			.orch__wire { position: relative; height: 3px; background: var(--line); overflow: hidden; }
			.pulse { position: absolute; top: -3px; left: -20%; width: 40px; height: 9px; border-radius: 9px; background: var(--gold); box-shadow: var(--glow-gold); animation: travel 2s linear infinite; }
			@keyframes travel { to { left: 110%; } }
			.orch__hub { width: 180px; height: 180px; border-radius: 50%; background: var(--surface-raised); display: grid; place-items: center; align-content: center; gap: 12px; box-shadow: var(--glow-gold); color: var(--gold); }
			.orch__hublabel { font-family: var(--font-display); font-weight: 600; color: var(--ink); font-size: 18px; }
			.orch__agents { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding-left: 56px; position: relative; }
			.orch__agents::before { content: ''; position: absolute; left: 0; top: 50%; width: 56px; height: 3px; background: var(--gold); }
			.agent { display: flex; align-items: center; gap: 12px; padding: 10px 18px 10px 10px; border-radius: var(--radius-pill); background: var(--surface); box-shadow: var(--shadow-card); font-weight: 600; font-size: 17px; }
			.agent img { width: 46px; height: 46px; object-fit: contain; border-radius: 50%; background: var(--illus); padding: 5px; }
			.agent:nth-child(2) { transition-delay: .08s; } .agent:nth-child(3) { transition-delay: .16s; } .agent:nth-child(4) { transition-delay: .24s; } .agent:nth-child(5) { transition-delay: .32s; } .agent:nth-child(6) { transition-delay: .4s; }
			.agent.is-pick.on { box-shadow: var(--glow-gold); background: var(--gold-soft); color: var(--gold-text); animation: pick 2.4s 1s ease-in-out infinite; }
			@keyframes pick { 50% { transform: scale(1.04); } }
			.rules { display: flex; gap: 12px; flex-wrap: wrap; margin-top: auto; }
			.rules .q-badge { height: 40px; padding: 0 18px; font-size: 14px; }

			/* ── 6 · Community ── */
			.trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
			.feature .q-illus { margin: 20px 20px 0; height: 210px; }
			.feature .q-illus img { max-height: 176px; width: auto; }
			.feature .q-card__body { gap: 10px; }
			.feature .q-card__body .q-badge { align-self: flex-start; }
			.feature .q-h2 { font-size: 24px; line-height: 30px; }
			.feature p { font-size: 17px; }

			/* ── 7 · Trust ── */
			.triage { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-top: 8px; }
			.triage::before { content: ''; position: absolute; left: 6%; right: 6%; top: 34px; height: 3px; background: var(--line); }
			.triage__step { position: relative; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; font-weight: 600; font-size: 17px; }
			.triage__step small { font-weight: 400; font-size: 13px; color: var(--ink-subtle); }
			.triage__ic { width: 68px; height: 68px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-raised); box-shadow: var(--shadow-card); font-family: var(--font-display); font-size: 24px; color: var(--gold-text); }
			.triage__step--ok .triage__ic { background: var(--green); color: var(--on-green); box-shadow: var(--glow-green); }
			.triage__token { position: absolute; top: 26px; left: 6%; width: 18px; height: 18px; border-radius: 50%; background: var(--gold); box-shadow: var(--glow-gold); animation: token 4s cubic-bezier(.6,0,.4,1) infinite; }
			@keyframes token { 0% { left: 8%; opacity: 0; } 8% { opacity: 1; } 25% { left: 29%; } 45% { left: 49%; } 65% { left: 69%; } 85% { left: 89%; background: var(--green); } 100% { left: 89%; opacity: 0; background: var(--green); } }
			.trust { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
			.trust .q-alert { padding: 18px 20px; }
			.trust .q-alert__title { font-size: 18px; line-height: 26px; }
			.trust .q-alert__icon { width: 40px; height: 40px; font-size: 18px; }

			/* ── Puntos QUILLART ── */
			.points { display: grid; grid-template-columns: 1fr 300px 1fr; gap: 64px; align-items: center; }
			.points__col { display: flex; flex-direction: column; gap: 18px; }
			.spot { position: relative; display: flex; align-items: center; gap: 16px; padding: 12px 20px 12px 12px; border-radius: var(--radius-pill); background: var(--surface); box-shadow: var(--shadow-card); }
			.spot img { width: 64px; height: 64px; flex: none; object-fit: contain; border-radius: 50%; background: var(--illus); padding: 7px; }
			.spot div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
			.spot b { font-family: var(--font-display); font-size: 20px; }
			.spot span { font-size: 16px; color: var(--ink-muted); }
			.spot::after { content: ''; position: absolute; top: 50%; height: 3px; width: 0; background: var(--gold); transition: width .6s .35s cubic-bezier(.2,.8,.2,1); }
			.points__col--l .spot::after { left: 100%; }
			.points__col--r .spot::after { right: 100%; }
			.spot.on::after { width: 64px; }
			.spot.on { box-shadow: var(--shadow-card), 0 0 0 1px color-mix(in srgb, var(--gold) 45%, transparent); }
			.points__qr { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; padding: 24px; border-radius: var(--radius-xl); background: var(--surface-raised); box-shadow: var(--glow-gold); }
			.qr { width: 200px; height: 200px; padding: 14px; border-radius: 18px; background: #fff; }
			.qr svg { display: block; width: 100%; height: 100%; }
			.qr__label { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--gold-text); }
			.qr__label .q-star { width: 20px; height: 20px; }
			.qr__cta { height: 36px; padding: 0 18px; font-size: 15px; }
			.is-active .points__qr { animation: qrbeat 3s 1.2s ease-in-out infinite; }
			@keyframes qrbeat { 50% { transform: scale(1.03); } }

			/* ── Negocio cotidiano ── */
			.shop { display: grid; grid-template-columns: 420px 1fr; gap: 40px; align-items: stretch; }
			.shopcard { border-radius: var(--radius-xl); background: var(--surface); color: var(--ink); overflow: hidden; box-shadow: var(--shadow-modal); display: flex; flex-direction: column; }
			.shopcard__illus { border-radius: 0; height: 190px; }
			.shopcard__illus img { max-height: 158px; width: auto; }
			.shopcard__body { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 8px; }
			.shopcard__badges { display: flex; gap: 8px; }
			.shopcard__facts { display: grid; grid-template-columns: auto auto 1fr; gap: 12px; margin: 8px 0 4px; }
			.shopcard__facts div { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: var(--radius-md); background: var(--bg); }
			.shopcard__facts dt { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-subtle); }
			.shopcard__facts dd { margin: 0; font-weight: 700; font-size: 17px; }
			.shopcard .q-sim-tag { align-self: flex-start; }
			.is-active .open-pulse { animation: openp 1.8s 1s ease-in-out infinite; }
			@keyframes openp { 50% { box-shadow: var(--glow-green); } }
			.pillars { display: flex; flex-direction: column; gap: 16px; }
			.pillar { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 18px 24px; border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-card); }
			.pillar p { margin: 0; font-size: 20px; line-height: 28px; }
			.pillar small { font-size: 15px; color: var(--ink-muted); }
			.pillar small b { color: var(--ink); }
			.pillar__tag { align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 4px 12px; border-radius: var(--radius-pill); }
			.pillar--green { box-shadow: var(--shadow-card), inset 4px 0 0 var(--green); } .pillar--green .pillar__tag { background: var(--green-soft); color: var(--green-text); }
			.pillar--gold { box-shadow: var(--shadow-card), inset 4px 0 0 var(--gold); } .pillar--gold .pillar__tag { background: var(--gold-soft); color: var(--gold-text); }
			.pillar--ink { box-shadow: var(--shadow-card), inset 4px 0 0 var(--line-control); } .pillar--ink .pillar__tag { background: var(--line); color: var(--ink); }

			/* QR scan step in Lucas's demo */
			.scan { align-self: center; display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: var(--radius-pill); background: var(--gold-soft); color: var(--gold-text); font-size: 13px; font-weight: 600; }
			.scan__qr { width: 22px; height: 22px; border-radius: 4px; background:
				conic-gradient(from 0deg, var(--ink) 25%, transparent 0 50%, var(--ink) 0 75%, transparent 0) 0 0 / 8px 8px; }
			.scan.on .scan__qr { animation: scanfl .9s .3s ease 2; }
			@keyframes scanfl { 50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--gold) 40%, transparent); } }

			/* ── 8 · People ── */
			.people { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
			.person { background: var(--surface); border-radius: var(--radius-lg); padding: 20px 20px 24px; display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-card); }
			.person .q-illus { height: 200px; margin-bottom: 6px; }
			.person .q-illus img { max-height: 168px; width: auto; }
			.person .q-h2 { font-size: 30px; line-height: 36px; }
			.person p { font-size: 17px; }
			.person .q-badge { align-self: flex-start; }
			.person--gold.on { box-shadow: var(--glow-gold); } .person--green.on { box-shadow: var(--glow-green); } .person--red.on { box-shadow: var(--glow-red); }
			.dims { display: flex; gap: 12px; flex-wrap: wrap; margin-top: auto; }
			.dim { display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: var(--radius-pill); background: var(--surface-raised); font-weight: 600; font-size: 17px; box-shadow: inset 0 0 0 1px var(--line); }
			.dims.on .dim { animation: popin .5s both cubic-bezier(.2,.8,.2,1.3); }
			.dims .dim:nth-child(2) { animation-delay: .1s; } .dims .dim:nth-child(3) { animation-delay: .2s; } .dims .dim:nth-child(4) { animation-delay: .3s; } .dims .dim:nth-child(5) { animation-delay: .4s; }
			@keyframes popin { from { opacity: 0; transform: scale(.6); } }
			.dim--sm { height: 32px; padding: 0 14px; font-size: 14px; }

			/* ── 9–11 · Demo ── */
			.s-demo { flex-direction: row; align-items: center; gap: 72px; }
			.demo__side { flex: 1; display: flex; flex-direction: column; gap: 22px; }
			.demo__side .q-lead { font-size: 22px; line-height: 32px; max-width: 520px; }
			.demo__tags { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
			.phone { width: 460px; height: 760px; flex: none; border-radius: 48px; background: var(--bg); color: var(--ink); font-family: var(--font-sans); padding: 14px; box-shadow: 0 0 0 10px #0B131E, var(--shadow-modal); display: flex; flex-direction: column; overflow: hidden; }
			.phone--sm { width: 400px; height: 400px; }
			.phone__bar { display: flex; align-items: center; gap: 10px; padding: 12px 12px 14px; border-bottom: 1px solid var(--line); font-size: 16px; }
			.phone__bar .q-sim-tag { margin-left: auto; }
			.phone__tile { width: 32px; height: 32px; border-radius: 10px; }
			.phone__tile .q-star { width: 16px; height: 16px; }
