---
import { BottomNav } from "../components/home/bottom-nav";
import { TopBar } from "../components/home/top-bar";
import CorridorMap from "../components/map/corridor-map";
import BaseLayout from "../layouts/base-layout.astro";
import { loadCorridorData } from "../lib/corridor/corridor-data";
import { homeContent } from "../lib/home-content";

const { data, source } = await loadCorridorData();
const { aiHref } = homeContent;
---

<BaseLayout title="Mapa del corredor piloto">
	{/* Phones and tablets: the map fills the screen above the tab bar. Desktop: a top bar replaces it. */}
	<div class="flex h-[calc(100dvh-3px)] w-full flex-col">
		<TopBar current="explore" aiHref={aiHref} />
		<main class="relative min-h-0 flex-1">
			<CorridorMap client:only="react" data={data} source={source} />
		</main>
		<BottomNav current="explore" aiHref={aiHref} />
	</div>
</BaseLayout>
