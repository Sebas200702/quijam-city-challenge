---
import { BottomNav } from "../components/home/bottom-nav";
import { OverchargeReportPage } from "../components/reports/overcharge-report-page";
import SiteFooter from "../components/site/site-footer.astro";
import SiteHeader from "../components/site/site-header.astro";
import BaseLayout from "../layouts/base-layout.astro";
import { loadCorridorData } from "../lib/corridor/corridor-data";
import { homeContent } from "../lib/home-content";
import { buildSelectableFareRoutes } from "../lib/reports/overcharge-routes";

const { data } = await loadCorridorData();
const routes = buildSelectableFareRoutes(data);
const initialSegmentCode = Astro.url.searchParams.get("segment");
const { aiHref } = homeContent;
---

<BaseLayout
	title="Reportar cobro abusivo · QUILLART"
	titleKey="reports.pageTitle"
	theme="light"
>
	<div class="mx-auto flex min-h-[calc(100dvh-3px)] w-full flex-col">
		<SiteHeader current="map" homeHref="/inicio" />
		<main class="mx-auto w-full max-w-xl flex-1 px-4 pt-4 pb-8 lg:py-8">
			<OverchargeReportPage
				client:load
				routes={routes}
				initialSegmentCode={initialSegmentCode}
			/>
		</main>
		<SiteFooter variant="slim" />
		<BottomNav client:load current="map" aiHref={aiHref} />
	</div>
</BaseLayout>
