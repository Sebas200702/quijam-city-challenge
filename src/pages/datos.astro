---
import { OpenDataPortal } from "../components/open-data/open-data-portal";
import SiteFooter from "../components/site/site-footer.astro";
import SiteHeader from "../components/site/site-header.astro";
import BaseLayout from "../layouts/base-layout.astro";
import { homeContent } from "../lib/home-content";
import { loadOpenDataCatalog } from "../lib/open-data/open-data-server";

const initialCatalog = await loadOpenDataCatalog();
const { aiHref } = homeContent;
---

<BaseLayout translated={false} title="Portal de datos abiertos · QUILLART" theme="light">
	<SiteHeader current="datos" homeHref="/inicio" title="Datos abiertos" />
	<OpenDataPortal client:load initialCatalog={initialCatalog} aiHref={aiHref} />
	<SiteFooter variant="slim" />
</BaseLayout>
