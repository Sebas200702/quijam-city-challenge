---
import { ModerationWithMfa } from "../components/city/moderation-with-mfa";
import SiteFooter from "../components/site/site-footer.astro";
import SiteHeader from "../components/site/site-header.astro";
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout
	title="Moderación de la comunidad"
	titleKey="forum.moderationPageTitle"
	theme="dark"
	dock="city"
>
	<SiteHeader
		variant="compact"
		homeHref="/ciudad"
		links={false}
		cta={false}
		title="Moderación"
		titleKey="forum.moderation.title"
	/>
	<ModerationWithMfa client:only="react" />
	<SiteFooter variant="slim" />
</BaseLayout>
