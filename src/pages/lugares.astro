---
import { PlacesPage } from "../components/community/places-page";
import BaseLayout from "../layouts/base-layout.astro";
import SiteFooter from "../components/site/site-footer.astro";
import SiteHeader from "../components/site/site-header.astro";
import { homeContent } from "../lib/home-content";

const { aiHref } = homeContent;
---

<BaseLayout title="Lugares y naturaleza · QUILLART" titleKey="places.pageTitle">
	<SiteHeader current="places" homeHref="/inicio">
		<a slot="actions" href="/perfil" class="q-btn q-btn--ghost q-btn--sm min-h-11 max-lg:hidden!"><span data-i18n="nav.profile">Perfil</span></a>
	</SiteHeader>
	<PlacesPage client:only="react" aiHref={aiHref} />
	<SiteFooter variant="slim" />
</BaseLayout>
