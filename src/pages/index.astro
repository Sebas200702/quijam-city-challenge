---
// Public landing page: Quillart AI as the way into the city.
import AgentGrid from "../components/landing/agent-grid.astro";
import HowItWorks from "../components/landing/how-it-works.astro";
import JoinBand from "../components/landing/join-band.astro";
import LandingHero from "../components/landing/landing-hero.astro";
import PromptMarquee from "../components/landing/prompt-marquee.astro";
import TrustStrip from "../components/landing/trust-strip.astro";
import UpcomingSection from "../components/landing/upcoming-section.astro";
import SiteFooter from "../components/site/site-footer.astro";
import SiteHeader from "../components/site/site-header.astro";
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout
	title="QUILLART · Barranquilla, a una conversación"
	titleKey="landing.pageTitle"
	theme="light"
	dock={false}
>
	<div class="overflow-x-clip">
		<SiteHeader />
		<main>
			<LandingHero />
			<PromptMarquee />
			<AgentGrid />
			<HowItWorks />
			<UpcomingSection />
			<TrustStrip />
			<JoinBand />
		</main>
		<SiteFooter variant="full" />
	</div>
</BaseLayout>
