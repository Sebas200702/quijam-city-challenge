---
import { AiPromptLink } from "../components/home/ai-prompt-link";
import { BottomNav } from "../components/home/bottom-nav";
import { FeatureGrid } from "../components/home/feature-grid";
import { HomeHeader } from "../components/home/home-header";
import { MatchCard } from "../components/home/match-card";
import BaseLayout from "../layouts/base-layout.astro";
import { homeContent } from "../lib/home-content";

const { match, features, aiHref } = homeContent;
---

<BaseLayout title="QUILLART · Barranquilla 2034" theme="light" rememberTheme>
	<div class="mx-auto flex min-h-[calc(100dvh-3px)] w-full max-w-md flex-col lg:max-w-6xl">
		<main class="flex flex-1 flex-col gap-4 px-4 pt-4 pb-24 lg:gap-10 lg:px-8 lg:pt-6 lg:pb-16">
			<HomeHeader
				weatherLabel={homeContent.weatherLabel}
				current="home"
				aiHref={aiHref}
				client:load
			/>
			{/* Mobile: one column in DOM order. Desktop: greeting + AI on the left, match on the right, features below. */}
			<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-x-12 lg:gap-y-10">
				<div class="lg:col-start-1 lg:row-start-1 lg:self-end">
					<h1 class="q-display lg:text-[56px] lg:leading-[60px]">
						{homeContent.greeting}
					</h1>
					<p class="q-p q-muted font-[var(--font-display)] text-xl leading-[26px] lg:text-2xl lg:leading-8">
						{homeContent.tagline}
					</p>
				</div>
				<div class="lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
					<MatchCard
						timeLabel={match.timeLabel}
						title={match.title}
						venue={match.venue}
						illustration={match.illustration}
					/>
				</div>
				<div class="lg:col-span-2 lg:row-start-3">
					<FeatureGrid items={features} />
				</div>
				{/* Mobile: pinned above the tab bar so it is always reachable. Desktop: in the flow. */}
				<div class="fixed inset-x-4 bottom-[76px] z-20 mx-auto max-w-sm lg:static lg:inset-auto lg:z-auto lg:mx-0 lg:max-w-none lg:col-start-1 lg:row-start-2 lg:self-start">
					<AiPromptLink href={aiHref} />
				</div>
			</div>
		</main>
		<BottomNav current="home" aiHref={aiHref} />
	</div>
</BaseLayout>
