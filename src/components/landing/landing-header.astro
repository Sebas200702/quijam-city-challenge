---
// Top bar of the landing: brand, main sections and the way into Quillart AI.
import { SecondaryMenu } from "../visitor-home/secondary-menu";

const links = [
	{ href: "/agenda", label: "Agenda", key: "agenda" },
	{ href: "/foro", label: "Foros", key: "forums" },
	{ href: "/lugares", label: "Lugares", key: "places" },
	{ href: "/mapa", label: "Mapa", key: "map" },
];
---

<header class="landing-header mx-auto flex w-full max-w-6xl items-center gap-2 px-3 sm:gap-3 sm:px-4 py-3 lg:gap-6 lg:px-8">
	<a href="/" class="q-logo flex-1 shrink-0" aria-label="QUILLART, inicio" data-i18n-attr="aria-label:landing.header.homeLabel">
		<span class="q-logo__tile" aria-hidden="true">
			<span class="q-star" style="width: 22px; height: 22px"></span>
		</span>
		<span class="q-logo__text">
			<span class="q-logo__word">QUILLART</span>
			<span class="q-logo__sub">Barranquilla</span>
		</span>
	</a>
	<nav aria-label="Secciones" data-i18n-attr="aria-label:landing.header.navLabel" class="hidden lg:block">
		<ul class="m-0 flex list-none items-center gap-1 p-0">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="q-btn q-btn--ghost q-btn--sm min-h-11">
							<span data-i18n={`landing.header.${link.key}`}>{link.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<SecondaryMenu client:load />
	{/* Visible on phones too so visitors can always enter Quillart from the navbar. */}
	<a href="/inicio" class="q-btn q-btn--secondary q-btn--sm min-h-11 shrink-0 gap-1.5 whitespace-nowrap" aria-label="Abrir Quillart AI" data-i18n-attr="aria-label:landing.header.openAi">
		<span>Quillart</span>
		<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
	</a>
</header>

<style is:global>
	/* Phones: keep the logo whole. The language stays reachable from the menu sheet. */
	@media (max-width: 639px) {
		.landing-header .visitor-chip-btn {
			display: none;
		}
	}
	@media (max-width: 359px) {
		.landing-header .q-logo__tile {
			display: none;
		}
	}
</style>
