---
// "Habla o escribe": voice is only the channel; text always works.
import { Keyboard, Mic, ShieldCheck, Waypoints } from "lucide-react";

const steps = [
	{
		icon: Keyboard,
		title: "Escribe o toca el micrófono",
		text: "Lo que dices se convierte en texto. Si prefieres no usar la voz, escribir funciona igual.",
	},
	{
		icon: Waypoints,
		title: "Te atiende el agente indicado",
		text: "El orquestador lee tu mensaje y lo pasa a Agenda, Comunidad, Lugares, Movilidad, Reportes o Tu cuenta.",
	},
	{
		icon: ShieldCheck,
		title: "Tú confirmas cada acción",
		text: "Inscribirte, publicar o reportar siempre te pide un sí antes de hacerse.",
	},
];
---

<section aria-labelledby="voice-title" class="bg-[var(--surface)]">
	<div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:px-8 lg:py-16">
		<div class="q-sec__head">
			<p class="q-eyebrow">Habla o escribe</p>
			<h2 id="voice-title" class="q-h1">La voz es el canal, no el centro</h2>
			<p class="q-lead">
				Habla en tu idioma cuando tengas las manos ocupadas o escribe cuando estés
				en un lugar con ruido. La respuesta y lo que puedes hacer son los mismos.
			</p>
			<div class="mt-2 flex flex-wrap gap-3">
				<a href="/inicio" class="q-btn q-btn--primary">
					<Mic size={18} strokeWidth={1.75} aria-hidden="true" />
					Hablar con Quillart AI
				</a>
				<a href="/prueba-guia" class="q-btn q-btn--ghost">Guía por voz (beta)</a>
			</div>
		</div>
		<ol class="m-0 grid list-none gap-4 p-0">
			{
				steps.map((step, index) => (
					<li class="flex gap-4 rounded-[var(--radius-lg)] bg-[var(--bg)] p-5">
						<span class="q-tile q-tile--gold" aria-hidden="true">
							<step.icon size={24} strokeWidth={1.75} />
						</span>
						<div class="min-w-0">
							<h3 class="q-h3">
								<span class="q-num q-muted mr-1">{index + 1}.</span>
								{step.title}
							</h3>
							<p class="q-p q-muted mt-1">{step.text}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
