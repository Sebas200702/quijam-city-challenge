---
// "Un agente para cada cosa": the six specialized agents and what each can do.
import {
	CalendarDays,
	Megaphone,
	MessagesSquare,
	Route,
	Trees,
	UserRound,
} from "lucide-react";
import type { AssistantAgentId } from "../../lib/assistant/assistant-types";
import { AGENT_CARDS } from "./landing-content";

const ICONS: Record<AssistantAgentId, typeof CalendarDays> = {
	agenda: CalendarDays,
	community: MessagesSquare,
	places: Trees,
	mobility: Route,
	city_reports: Megaphone,
	account: UserRound,
};
---

<section aria-labelledby="agents-title" class="mx-auto w-full max-w-6xl px-4 py-12 lg:px-8 lg:py-16">
	<div class="q-sec__head mb-6 lg:mb-8">
		<p class="q-eyebrow">Cómo funciona</p>
		<h2 id="agents-title" class="q-h1">Un agente para cada cosa</h2>
		<p class="q-lead">
			Tú hablas con Quillart AI. Detrás, un orquestador le pasa tu mensaje al
			agente especializado en esa sección, que conoce sus datos y sabe hacer sus
			acciones.
		</p>
	</div>
	<ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
		{
			AGENT_CARDS.map((agent) => {
				const Icon = ICONS[agent.id];
				return (
					<li class="q-card gap-3 p-5">
						<div class="flex items-center gap-3">
							<span class={`q-tile q-tile--${agent.tone}`} aria-hidden="true">
								<Icon size={24} strokeWidth={1.75} />
							</span>
							<p class="q-eyebrow">Agente de {agent.name}</p>
						</div>
						<h3 class="q-h2">{agent.action}</h3>
						<p class="q-p q-muted flex-1">{agent.description}</p>
						<a
							href={agent.example.href}
							class="q-chip self-start text-left no-underline"
						>
							<span>
								<span class="q-sr">Preguntar: </span>“{agent.example.label}”
							</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</section>
