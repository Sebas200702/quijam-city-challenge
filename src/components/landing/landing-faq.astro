---
// Frequently asked questions, as native disclosure widgets (no JavaScript).
import { ChevronDown } from "lucide-react";
import { FAQ_ITEMS } from "./landing-content";
---

<section aria-labelledby="faq-title" class="bg-[var(--surface)]">
	<div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:px-8 lg:py-16">
		<div class="q-sec__head">
			<p class="q-eyebrow">Preguntas frecuentes</p>
			<h2 id="faq-title" class="q-h1">Lo que más nos preguntan</h2>
			<p class="q-lead">¿Te queda otra duda? Pregúntale a Quillart AI.</p>
		</div>
		<div class="flex flex-col gap-3">
			{
				FAQ_ITEMS.map((item) => (
					<details class="landing-faq group rounded-[var(--radius-lg)] bg-[var(--bg)]">
						<summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 font-semibold">
							<span>{item.question}</span>
							<ChevronDown
								size={20}
								strokeWidth={1.75}
								aria-hidden="true"
								className="shrink-0 transition-transform group-open:rotate-180"
							/>
						</summary>
						<p class="q-p q-muted px-5 pb-5">{item.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.landing-faq summary::-webkit-details-marker {
		display: none;
	}
</style>
