---
// "Una comunidad cuidada": the moderation triage and privacy, in plain words.
import { Filter, Lock, Phone, Siren, UsersRound } from "lucide-react";

const steps = [
	{
		icon: Filter,
		tone: "green",
		title: "Un filtro revisa todo antes de publicarse",
		text: "Reglas claras detectan insultos, amenazas, spam y datos personales expuestos como teléfonos o cédulas; un modelo de moderación (OpenJev) ayuda con el resto.",
	},
	{
		icon: UsersRound,
		tone: "gold",
		title: "Las personas deciden lo dudoso",
		text: "Si el filtro no está seguro, la publicación espera en la cola de moderación hasta que alguien del equipo la revise.",
	},
	{
		icon: Siren,
		tone: "red",
		title: "Los riesgos llegan a la ciudad",
		text: "Si una publicación habla de un riesgo en el espacio público, como un arroyo crecido, se avisa a la ciudad para que lo atienda.",
	},
] as const;
---

<section aria-labelledby="care-title" class="bg-[var(--surface)]">
	<div class="mx-auto w-full max-w-6xl px-4 py-12 lg:px-8 lg:py-16">
		<div class="q-sec__head mb-6 lg:mb-8">
			<p class="q-eyebrow">Confianza</p>
			<h2 id="care-title" class="q-h1">Una comunidad cuidada</h2>
			<p class="q-lead">
				Eventos y foros abiertos a todos, con reglas que protegen a quien publica y a
				quien lee.
			</p>
		</div>
		<ol class="m-0 grid list-none grid-cols-1 gap-4 p-0 lg:grid-cols-3">
			{
				steps.map((step) => (
					<li class="flex flex-col gap-3 rounded-[var(--radius-lg)] bg-[var(--bg)] p-5">
						<span class={`q-tile q-tile--${step.tone}`} aria-hidden="true">
							<step.icon size={24} strokeWidth={1.75} />
						</span>
						<h3 class="q-h2">{step.title}</h3>
						<p class="q-p q-muted">{step.text}</p>
					</li>
				))
			}
		</ol>
		<div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
			<div class="flex gap-4 rounded-[var(--radius-lg)] bg-[var(--red-soft)] p-5">
				<Phone size={24} strokeWidth={1.75} aria-hidden="true" className="shrink-0 text-[var(--red-text)]" />
				<p class="q-p">
					<strong>¿Es una emergencia?</strong> Llama a la Línea 123. Quillart no reemplaza
					a los servicios de emergencia.
				</p>
			</div>
			<div class="flex gap-4 rounded-[var(--radius-lg)] bg-[var(--green-soft)] p-5">
				<Lock size={24} strokeWidth={1.75} aria-hidden="true" className="shrink-0 text-[var(--green-text)]" />
				<p class="q-p">
					<strong>Tus datos, protegidos.</strong> Los tratamos según la Ley 1581 de 2012, y
					tus datos personales nunca se envían al servicio de moderación automática.
				</p>
			</div>
		</div>
	</div>
</section>
