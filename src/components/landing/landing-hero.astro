---
// Hero: the conversation is the way in. The ask box is a plain GET form, so it
// works before (or without) JavaScript.
import { ArrowUp, Mic } from "lucide-react";
import { ASSISTANT_HREF } from "../../lib/assistant/assistant-labels";
import { HERO_PROMPTS } from "./landing-content";
---

<section
	aria-labelledby="hero-title"
	class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 pt-8 pb-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:px-8 lg:pt-16 lg:pb-20"
>
	<div class="flex min-w-0 flex-col gap-6">
		<p class="q-eyebrow flex items-center gap-2">
			<span class="q-star text-[var(--gold-text)]" style="width: 14px; height: 14px" aria-hidden="true"></span>
			Quillart AI · para quienes viven y visitan Barranquilla
		</p>
		<h1 id="hero-title" class="q-display lg:text-[56px] lg:leading-[60px]">
			Barranquilla, a una conversación
		</h1>
		<p class="q-lead">
			Pregunta qué hacer, inscríbete en un plan, publica el evento de tu barrio,
			abre un foro o reporta algo a la ciudad. Escribe o habla: Quillart AI te
			conecta con el agente indicado y tú confirmas cada paso.
		</p>

		<form action={ASSISTANT_HREF} method="get" role="search" aria-label="Pregúntale a Quillart AI">
			<label for="hero-ask" class="q-sr">Escribe tu pregunta para Quillart AI</label>
			<div class="q-prompt shadow-[var(--shadow-card)]">
				<input
					id="hero-ask"
					name="q"
					type="text"
					required
					maxlength="500"
					autocomplete="off"
					enterkeyhint="send"
					placeholder="¿Qué hay para hacer este fin de semana?"
				/>
				<a
					href={ASSISTANT_HREF}
					class="q-tile q-tile--gold no-underline"
					style="width: 44px; height: 44px; border-radius: 50%"
					aria-label="Hablar con Quillart AI por voz"
				>
					<Mic size={18} strokeWidth={1.75} aria-hidden="true" />
				</a>
				<button
					type="submit"
					class="q-btn q-btn--primary q-btn--icon"
					aria-label="Preguntar"
				>
					<ArrowUp size={20} strokeWidth={1.75} aria-hidden="true" />
				</button>
			</div>
		</form>

		<div>
			<p class="q-sm q-muted mb-2">O empieza con una de estas:</p>
			<ul class="m-0 flex list-none flex-wrap gap-2 p-0">
				{
					HERO_PROMPTS.map((item) => (
						<li class="max-w-full">
							<a href={item.href} class="q-chip max-w-full text-left no-underline">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="flex flex-wrap items-center gap-3">
			<a href="/perfil" class="q-btn q-btn--secondary">Crear mi cuenta</a>
			<a href="/agenda" class="q-btn q-btn--ghost">Ver la agenda</a>
		</div>
	</div>

	<figure class="m-0 min-w-0" aria-labelledby="hero-example-caption">
		<div class="q-card q-card--raised gap-4 p-5 lg:p-6">
			<div class="q-msg q-msg--user">
				<div class="q-msg__col">
					<div class="q-bubble">¿Hay algo de tambora este sábado? Quiero ir con mi hija.</div>
				</div>
			</div>
			<div class="q-msg q-msg--ai" style="align-items: flex-start">
				<span class="q-avatar" aria-hidden="true">
					<span class="q-star" style="width: 16px; height: 16px"></span>
				</span>
				<div class="q-msg__col">
					<span class="q-msg__who">Agente de Agenda</span>
					<div class="q-bubble">
						Encontré un taller de ritmos del Carnaval en Barrio Abajo, gratis y
						con cupos. ¿Quieres que te inscriba?
					</div>
					<div class="flex flex-wrap gap-2" aria-hidden="true">
						<span class="q-badge q-badge--optimal">Tú confirmas</span>
						<span class="q-badge q-badge--neutral">Nada se hace sin tu sí</span>
					</div>
				</div>
			</div>
			<figcaption id="hero-example-caption" class="q-sm q-subtle">
				Ejemplo de conversación: el orquestador entiende la pregunta y se la pasa al agente
				de la sección indicada.
			</figcaption>
		</div>
	</figure>
</section>
