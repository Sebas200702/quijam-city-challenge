---
// Footer: sections, help and legal basics.
const groups = [
	{
		key: "participate",
		title: "Participa",
		links: [
			{ href: "/inicio", label: "Quillart AI", key: null },
			{ href: "/agenda", label: "Agenda", key: "agenda" },
			{
				href: "/agenda/nuevo",
				label: "Publicar un evento",
				key: "publishEvent",
			},
			{ href: "/foro", label: "Foros", key: "forums" },
		],
	},
	{
		key: "explore",
		title: "Explora",
		links: [
			{ href: "/lugares", label: "Lugares y naturaleza", key: "placesNature" },
			{ href: "/mapa", label: "Mapa del corredor", key: "corridorMap" },
		],
	},
	{
		key: "accountCity",
		title: "Cuenta y ciudad",
		links: [
			{ href: "/perfil", label: "Mi cuenta", key: "myAccount" },
			{ href: "/datos", label: "Datos abiertos", key: "openData" },
			{ href: "/moderacion", label: "Moderación", key: "moderation" },
			{ href: "/ciudad", label: "Centro de Mando", key: "commandCenter" },
		],
	},
];
---

<footer class="border-t border-[var(--line)]">
	<div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-10 lg:grid-cols-[1.2fr_2fr] lg:px-8">
		<div class="flex flex-col gap-3">
			<a href="/" class="q-logo" aria-label="QUILLART, inicio" data-i18n-attr="aria-label:landing.footer.homeLabel">
				<span class="q-logo__tile" aria-hidden="true">
					<span class="q-star" style="width: 22px; height: 22px"></span>
				</span>
				<span class="q-logo__word">QUILLART</span>
			</a>
			<p class="q-sm q-muted max-w-xs" data-i18n="landing.footer.tagline">
				Barranquilla, a una conversación.
			</p>
			<p class="q-sm">
				<strong data-i18n="landing.footer.emergencies">Emergencias:</strong> <span data-i18n="landing.footer.emergenciesLine">Línea 123</span>
			</p>
		</div>
		<nav aria-label="Pie de página" data-i18n-attr="aria-label:landing.footer.navLabel" class="grid grid-cols-2 gap-6 sm:grid-cols-3">
			{
				groups.map((group) => (
					<div>
						<h2 class="q-eyebrow mb-2" data-i18n={`landing.footer.${group.key}`}>{group.title}</h2>
						<ul class="m-0 list-none p-0">
							{group.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="flex min-h-11 items-center text-[var(--ink)] no-underline lg:hover:underline"
									>
										{link.key ? <span data-i18n={`landing.footer.${link.key}`}>{link.label}</span> : link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
	</div>
	<div class="mx-auto w-full max-w-6xl px-4 pb-8 lg:px-8">
		<p class="q-sm q-subtle" data-i18n="landing.footer.legal">
			Tratamiento de datos según la Ley 1581 de 2012. Hecho en Barranquilla.
		</p>
	</div>
</footer>
