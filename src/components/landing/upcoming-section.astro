---
// "Próximos planes": a small live window into the community agenda.
import { UpcomingEvents } from "./upcoming-events";
---

<section aria-labelledby="upcoming-title" class="mx-auto w-full max-w-6xl px-4 py-12 lg:px-8 lg:py-16">
	<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
		<h2 id="upcoming-title" class="q-h1" data-i18n="landing.upcoming.title">Próximos planes</h2>
		<a href="/agenda" class="q-btn q-btn--secondary min-h-11" data-i18n="landing.upcoming.viewAgenda">Ver la agenda</a>
	</div>
	<UpcomingEvents client:only="react" />
	<noscript>
		<p class="q-p q-muted"><a href="/agenda" data-i18n="landing.upcoming.noscriptLink">Abre la agenda</a> <span data-i18n="landing.upcoming.noscriptText">para ver los próximos planes.</span></p>
	</noscript>
</section>
