# Supabase project (Settings > API). The publishable key is safe in the browser.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key (Settings > API). Server only: never prefix with PUBLIC_.
# Needed to publish events, forum threads and replies after the moderation triage
# and to run the moderation queue. Without it the community runs on-device only.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key. Server only: never prefix with PUBLIC_ and never expose it to the browser.
GEMINI_API_KEY=

# OpenJev decision API (Codiv, free public experiment). Server only.
# Create a key at https://codiv.ai. Without a key the Decisor uses the weighted score
# and the forum moderation triage uses the hard rules only.
TYPESAFE_API_KEY=
# Optional. Default: https://api.codiv.ai (same API as https://api.typesafe.ai)
TYPESAFE_BASE_URL=
# Optional. Default: openjev-latest
OPENJEV_MODEL=

# Optional. Gemini Live model for the Guide. Defaults to the value in src/lib/guide/live-token-config.ts.
GEMINI_LIVE_MODEL=

# Optional. Gemini text model for the daily impact report. Defaults to the value in src/lib/impact-report/impact-report-server.ts.
GEMINI_REPORT_MODEL=

# Optional. Content-Security-Policy mode: enforce (default), report-only or off.
# Use report-only to check a new page or service without blocking it. See docs/22-seguridad-y-confianza.md.
CSP_MODE=
